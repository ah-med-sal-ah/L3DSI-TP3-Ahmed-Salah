<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clavier_fond"
    tools:context=".MainActivity">

    <!-- Ligne de séparation : 45 % de la hauteur -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- ===================== ZONE DU HAUT ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneHaut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise_fond"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/titre"
            android:textColor="@color/blanc"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ligne 1 : devise source + montant -->
        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:text="@string/montant_initial"
            android:textColor="@color/blanc"
            android:textSize="48sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitre"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/tvMontant"
            app:layout_constraintBottom_toBottomOf="@id/tvMontant"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bouton inverser -->
        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_inverser"
            android:src="@drawable/ic_swap"
            app:layout_constraintTop_toBottomOf="@id/tvMontant"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Ligne 2 : devise cible + résultat -->
        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:textColor="@color/blanc"
            android:textSize="48sp"
            app:layout_constraintTop_toBottomOf="@id/btnInverser"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/tvResultat"
            app:layout_constraintBottom_toBottomOf="@id/tvResultat"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bouton Convertir -->
        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_convertir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== CLAVIER NUMÉRIQUE ===================== -->
    <TableLayout
        android:id="@+id/clavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:stretchColumns="*"
        app:layout_constraintTop_toBottomOf="@id/guidelineHorizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn7" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_7"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn8" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_8"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn9" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_9"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn4" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_4"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn5" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_5"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn6" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_6"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn1" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_1"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn2" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_2"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btn3" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_3"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnC" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/btn_effacer"
                android:textColor="@color/rouge_clair" android:textSize="32sp" />
            <Button android:id="@+id/btn0" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/touche_0"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
            <Button android:id="@+id/btnPoint" style="?android:attr/borderlessButtonStyle"
                android:layout_height="match_parent" android:text="@string/btn_point"
                android:textColor="@color/turquoise_touche" android:textSize="32sp" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>